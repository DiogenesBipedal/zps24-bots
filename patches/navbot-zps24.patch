+const char* NavBotExt::Hook_GetPlayerNetworkIDString(const edict_t* edict)
+{
+	const char* original = META_RESULT_ORIG_RET(const char*);
+
+	if (original == nullptr || std::strcmp(original, "BOT") != 0)
+	{
+		RETURN_META_VALUE(MRES_IGNORED, nullptr);
+	}
+
+	// One buffer per client slot; the returned pointer must stay valid after the call.
+	static char s_fakeids[ABSOLUTE_PLAYER_LIMIT + 1][32];
+	const int index = gamehelpers->IndexOfEdict(const_cast<edict_t*>(edict));
+
+	if (index <= 0 || index > ABSOLUTE_PLAYER_LIMIT)
+	{
+		RETURN_META_VALUE(MRES_IGNORED, nullptr);
+	}
+
+	ke::SafeSprintf(s_fakeids[index], sizeof(s_fakeids[index]), "STEAM_0:0:%d", 1000 + index);
+	RETURN_META_VALUE(MRES_OVERRIDE, s_fakeids[index]);
+}
